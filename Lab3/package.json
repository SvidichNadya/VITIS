{
  "name": "lms-sfedu-playwright-security-lab",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "test": "playwright test --config=playwright.chrome.config.ts",
    "test:functional": "playwright test --config=playwright.chrome.config.ts tests/functional.spec.ts",
    "test:security": "playwright test --config=playwright.chrome.config.ts tests/security.spec.ts tests/security.Auth.spec.ts tests/security.CrossSiteRequestForgery.spec.ts tests/security.CrossSiteScripting.spec.ts tests/security.OpenRedirect.spec.ts tests/security.PublicAttackSurface.spec.ts tests/security.sql.spec.ts tests/secuutiry.SessionFixation.spec.ts tests/security.advanced.spec.ts",
    "test:critical": "playwright test --config=playwright.chrome.config.ts tests/security.Auth.spec.ts tests/security.CrossSiteRequestForgery.spec.ts",
    "test:advanced": "playwright test --config=playwright.chrome.config.ts tests/security.advanced.spec.ts",
    "test:all": "playwright test --config=playwright.chrome.config.ts tests/",
    "test:headed": "playwright test --config=playwright.chrome.config.ts --headed",
    "report": "playwright show-report playwright-report",
    "test:ci": "playwright test --config=playwright.chrome.config.ts --reporter=html,list",
    "test:blackbox": "playwright test --config=playwright.chrome.config.ts tests/security.PublicAttackSurface.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3"
  }
}
